# Django
DJANGO_SECRET_KEY=django-insecure-xxxxxxxxxx-change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx,api.blieve.in
# Set these values for HTTPS-only production deployments after confirming the
# production domain is serving valid TLS certificates.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# PostgreSQL
DB_NAME=jobcare_db
DB_USER=jobcare_user
DB_PASSWORD=ChangeMe123!
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_LIFETIME=24
JWT_REFRESH_TOKEN_LIFETIME=30

# Email (SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@blieve.in

# Firebase Cloud Messaging (FCM)
FCM_CREDENTIALS=/app/credentials/firebase-service-account.json
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=jobcare-voice-project
FIREBASE_PRIVATE_KEY_ID=xxxxxxxxxx
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYYYYYY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@jobcare-voice-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=yyyyyyyyyyyyyyyyyyyyyy

# Sarvam AI (Voice AI)
SARVAM_API_KEY=your-sarvam-ai-api-key
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Exotel â€“ configure the same random value in the Exotel webhook URL as
# ?token=<value>, or send it as X-Exotel-Webhook-Token where supported.
# Exotel â€“ configure the same random value in the Exotel webhook URL as
# ?token=<value>, or send it as X-Exotel-Webhook-Token where supported.
EXOTEL_WEBHOOK_TOKEN=replace-with-a-long-random-secret
EXOTEL_RECORDING_ALLOWED_HOSTS=

# Exotel API credentials (Voice IVR + SMS OTP)
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_SID=your-exotel-account-sid

# Exotel SMS (OTP delivery). Sender ID + DLT IDs are mandatory for India (TRAI).
# The OTP SMS body must match a DLT-approved template with the code as variable.
EXOTEL_SMS_SENDER_ID=EXOTEL
EXOTEL_DLT_ENTITY_ID=your-dlt-entity-id
EXOTEL_DLT_TEMPLATE_ID=your-dlt-template-id
EXOTEL_SMS_TYPE=transactional

# OTP delivery channel for phone login. 'email' = email OTP (temporary fallback
# while Exotel DLT is pending); 'sms' = Exotel SMS (once DLT clears).
AUTH_OTP_CHANNEL=email

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://blieve.in

# Sentry
SENTRY_DSN=https://xxxxxxxxx@xxxxxx.ingest.us.sentry.io/xxxxxx

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=jobcare-voice-media
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=media.blieve.in

# Security
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
